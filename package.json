{
  "name": "manzil",
  "version": "1.0.6",
  "private": true,
  "description": "Manzil (manzil.bond) \u2014 NVIDIA NIM -> Claude Code proxy, as a Tauri 2 desktop app",
  "author": "Zaheer Ahmad",
  "homepage": "https://manzil.bond",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 1420",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "dotenv -e .env -- tauri build",
    "app:icon": "tauri icon",
    "fetch:node": "node scripts/fetch-node.mjs",
    "sync:tauri": "node scripts/sync-tauri-versions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  }
}
