{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manzil",
  "version": "1.0.3",
  "identifier": "com.csofts.manzil",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "pnpm fetch:node"
  },
  "app": {
    "windows": [
      {
        "title": "Manzil",
        "width": 1100,
        "height": 910,
        "minWidth": 1000,
        "minHeight": 910,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "cSofts",
    "category": "DeveloperTool",
    "shortDescription": "Manzil - NVIDIA NIM -> Claude Code proxy",
    "longDescription": "Manzil - NVIDIA NIM ke models ko Claude Code mein chalane ke liye local proxy, Tauri 2 desktop app ke taur par.",
    "copyright": "Copyright (c) 2026 cSofts.com. All rights reserved.",
    "externalBin": ["binaries/node"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/dashingmza/manzil/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQjZCQUEwM0E2Nzk3OTIKUldTU2wyYzZvTHEyL3VXMVY2cjRscTZEekVEYnQvckF1N2VPVG9ZTDhSTDlzVmF5S1NQRVdMK28K"
    }
  }
}
